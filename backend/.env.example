# PostgreSQL (Prisma). Example:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/saas_db"
# Or set DB_* and leave DATABASE_URL empty (see src/config/database.ts + prisma.config.ts)
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=saas_db

# Optional `pg` pool tuning
# DB_POOL_SIZE=10
# DB_CONNECT_TIMEOUT_MS=30000

JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_REMEMBER_EXPIRES_IN=90d

GOOGLE_CLIENT_ID=467979994719-kkeb7nnl1s90ovtflagbhvr6a1r30dn5.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Resend (https://resend.com): API Keys → create key. MAIL_FROM must be a verified domain or onboarding@resend.dev
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=onboarding@resend.dev
# Angular dev server default: http://localhost:4200. Comma-separate multiple origins if needed.
FRONTEND_URL=http://localhost:4200

# Redis (JWT logout blocklist). When disabled or unreachable, the app uses an in-memory store (local dev only).
REDIS_DISABLED=true
REDIS_URL=redis://localhost:6379

# Cloudinary (avatars)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_AVATAR_FOLDER=ai-ads-generator/avatars
MAX_AVATAR_SIZE_MB=5
