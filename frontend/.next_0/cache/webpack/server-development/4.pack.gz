'MannedAlertNotification',NULL,NULL,8),(64808,42915,'object','1885395045404025289','/TwitterFeed/',0,1,1738348208,1738425665,0,0,'twitter_feed','TwitterFeed',NULL,NULL,41),(64809,42915,'object/*
